# ==========================================
# AI Code Explanation Assistant Environment Variables
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Model Configuration
# Providers supported: gemini, openai, anthropic
AI_PROVIDER=gemini

# Primary AI API Key (Required for live AI API calls)
# Supports Google Gemini API key, OpenAI API key, or Anthropic API key
AI_API_KEY=your_ai_api_key_here

# Specific Provider Keys (Alternative / Fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Names (Defaults: gemini-2.0-flash / gemini-1.5-flash, gpt-4o-mini, claude-3-5-sonnet-20241022)
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# MongoDB Database URI (Optional: system automatically falls back to in-memory/JSON storage if unavailable)
MONGODB_URI=mongodb://localhost:27017/ai_code_assistant

# Frontend Configuration (in frontend/.env)
# VITE_API_URL=http://localhost:5000/api
