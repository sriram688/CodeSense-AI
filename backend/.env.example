PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Model Configuration
# Providers supported: gemini, openai, anthropic
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here

# Specific API keys (optional if AI_API_KEY is provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MongoDB URI (Optional: will use resilient memory/storage fallback if unreachable)
MONGODB_URI=mongodb://localhost:27017/ai_code_assistant
